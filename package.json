{
  "name": "lecture-notes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts --production",
