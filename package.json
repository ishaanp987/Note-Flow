    "react-dom": "^19.1.0",
    "lucide-react": "latest",
    "zod": "^4.1.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@playwright/test": "latest",
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
